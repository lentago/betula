# The one interface that consumers in other repos read from this state (#119
# step 2): each consumer token's value, keyed by its Axiom token name.
# Consumers read it read-only with a terraform_remote_state data source on
# this root's state key (backend.tf), and take only their own entry. The
# contract and the access grant are in terraform/README.md § Tokens.
#
# A value is null until this config first creates or regenerates that token.
# Axiom returns a token's value only then, and the three tokens here were
# imported (#153), so each entry stays null until its first planned rotation.
# A consumer must treat null as "keep the current value", never as a value.
output "axiom_tokens" {
  description = "Axiom token values by token name (null until first created or regenerated by this config)."
  sensitive   = true
  value = {
    "solidago-ecs-ingest"    = axiom_token.solidago_ecs_ingest.token
    "cjp-solidago-alb"       = axiom_token.solidago_alb_ingest.token
    "cjp-solidago-alb-query" = axiom_token.solidago_alb_query.token
  }
}
