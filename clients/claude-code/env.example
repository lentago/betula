# betula claude-code client config. Copy to /etc/betula/claude-code.env (machine-wide,
# root:root 0644 without secrets, or 0640 root:<group> with them) or
# ~/.config/betula/claude-code.env (0600). Never commit the real file.

# Full-fidelity archive (secrets redacted). Must already exist: the shipper never
# creates it, so an unmounted NAS share is skipped, not written underneath.
BETULA_CC_ARCHIVE_DIR=/mnt/lentago/claude-state/transcripts

# Scrubbed live narration -> Grafana Cloud Loki (job="claude_transcript").
# logs:write-only access-policy token, same stack as the rest of betula.
GRAFANA_CLOUD_LOGS_URL=https://logs-prod-NNN.grafana.net
GRAFANA_CLOUD_LOGS_USER=
GRAFANA_CLOUD_LOGS_TOKEN=

# Colon-separated cwd prefixes or globs that ship NOTHING to either sink.
# Put every work-confidential checkout here.
BETULA_CC_EXCLUDE=

# Optional
# BETULA_CC_SINKS=archive,loki
# BETULA_CC_LOKI_MAX_AGE_S=3600
# BETULA_CC_HOST=
# BETULA_CC_STATE_DIR=~/.local/state/betula-cc
