# Secrets — never commit these
.env
*.env
log_shipping.env

# Host-local GitHub collector entries (private repo names) — never commit
queue_watch.local.json

# Temp files
/tmp/
*.log

# Python artifacts (aws client shipper)
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# Terraform (terraform/): provider cache and any local state. State lives in
# the S3 backend; the lock file (.terraform.lock.hcl) IS committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
